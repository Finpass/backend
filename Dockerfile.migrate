# Railway one-off service: applies db/migrations against $DATABASE_URL, then exits. Redeploy it after each new migration.
FROM golang:1.27-alpine
RUN go install github.com/pressly/goose/v3/cmd/goose@v3.29.0
COPY db/migrations /migrations
CMD ["sh", "-c", "goose -dir /migrations postgres \"$DATABASE_URL\" up"]
