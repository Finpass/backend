APP_ENV=development
PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shenzen?sslmode=disable
CORS_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://localhost:8001
INTERNAL_API_KEY=development-internal-key
SHUTDOWN_TIMEOUT_SECONDS=15

# Auth: JWT_SECRET must be 32+ chars; generate with `openssl rand -base64 48`
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TTL_HOURS=24
REMEMBER_TTL_DAYS=30

# Google sign-in: OAuth client ID from Google Cloud Console (Web application). Empty disables it.
GOOGLE_CLIENT_ID=

# Email OTP via SMTP (port 587 STARTTLS). Empty SMTP_HOST prints codes to the log in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Daily Financial Companion <no-reply@example.com>"
