APP_ENV=development
PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shenzen?sslmode=disable  # production: sslmode=require (TLS to the database)
CORS_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://localhost:8001
INTERNAL_API_KEY=development-internal-key
# Sent to the AI service as X-Internal-Api-Key (must match its INTERNAL_API_KEY); defaults to INTERNAL_API_KEY
AI_INTERNAL_API_KEY=development-internal-key
SHUTDOWN_TIMEOUT_SECONDS=15

# Auth: JWT_SECRET must be 32+ chars; generate with `openssl rand -base64 48`
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TTL_HOURS=24
REMEMBER_TTL_DAYS=30

# Google sign-in: OAuth client ID from Google Cloud Console (Web application). Empty disables it.
GOOGLE_CLIENT_ID=

# Email OTP via SMTP (port 587 STARTTLS). Empty SMTP_HOST prints codes to the log in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Finpass <no-reply@example.com>"

# WhatsApp delivery through GoWA (https://github.com/aldinokemal/go-whatsapp-web-multidevice), self-hosted REST API.
# Use the same user:password you start GoWA with (--basic-auth / APP_BASIC_AUTH) and the same secret as its --webhook-secret.
GOWA_BASE_URL=http://localhost:3000
GOWA_BASIC_AUTH_USER=
GOWA_BASIC_AUTH_PASSWORD=
GOWA_WEBHOOK_SECRET=
GOWA_DEVICE_ID=finpass
PUBLIC_APP_URL=https://finpass.com   # link inside briefings; must be reachable from a phone
# true starts the in-process daily briefing scheduler (needs a logged-in GoWA device)
WA_DAILY_ENABLED=false

# --- Production (Railway) ---
# APP_ENV=production refuses dev secrets. Required: DATABASE_URL, INTERNAL_API_KEY, JWT_SECRET, SMTP_HOST, MAIL_FROM.
# CORS_ORIGINS must list the frontend origin(s), comma separated, no trailing slash.
# AI_SERVICE_URL=http://<ai-service-name>.railway.internal:<ai PORT>  (private network)
# INTERNAL_API_KEY must equal the AI service's INTERNAL_API_KEY. Railway injects PORT itself.

# --- Column encryption (AES-256-GCM): required in production, optional locally (unset = plaintext) ---
# Generate each with: openssl rand -base64 32. Keep them apart from JWT_SECRET and never commit real values.
# DATA_KEK=
# DATA_INDEX_KEY=
# DATA_KEK_ID=k1                 # id of the active KEK; change it when rotating
# DATA_KEK_OLD=k0:<base64>       # retired KEKs, so older rows can still be read

# Sentry error reporting. Off when empty. Keep the real value in .env or the platform, not in git.
SENTRY_DSN=
